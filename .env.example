# Node server (required for backend proxy/cache mode)
OPENROUTER_API_KEY=sk-or-v1-xxxx
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_FALLBACK_MODEL=openrouter/auto
OPENROUTER_TOTAL_TIMEOUT_MS=9500
PORT=8787

# Front-end API base URL:
# - Local dev: leave empty (use Vite proxy /api -> localhost:8787)
# - Production: set to your backend public URL, e.g. https://your-backend.up.railway.app
# VITE_API_BASE_URL=

# Legacy front-end direct mode vars (optional, no longer required)
# VITE_OPENROUTER_API_KEY=sk-or-v1-xxxx
# VITE_OPENROUTER_MODEL=google/gemini-2.0-flash-001
# VITE_GEMINI_API_KEY=AIza...
# VITE_GEMINI_MODEL=gemini-1.5-flash
